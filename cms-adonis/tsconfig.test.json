{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "bin/**/*.ts",
    "index.ts",
    "providers/**/*.ts",
    "services/**/*.ts",
    "configure.ts",
    "stubs/**/*.ts",
    "commands/**/*.ts"
  ],
  "exclude": ["tests/fixtures/**"]
}
