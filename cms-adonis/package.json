{
  "name": "@sonata/cms-adonis",
  "version": "0.1.0",
  "private": true,
  "description": "AdonisJS side of the CMS: content storage, validation, commit and history endpoints",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./cms_provider": {
      "types": "./build/providers/cms_provider.d.ts",
      "default": "./build/providers/cms_provider.js"
    },
    "./services/main": {
      "types": "./build/services/main.d.ts",
      "default": "./build/services/main.js"
    },
    "./controller": {
      "types": "./build/src/controller.d.ts",
      "default": "./build/src/controller.js"
    },
    "./schema": {
      "types": "./build/src/schema.d.ts",
      "default": "./build/src/schema.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "node --import=@poppinss/ts-exec bin/test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@sonata/cms-core": "^0.1.0"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@vinejs/vine": "^4.0.0"
  },
  "devDependencies": {
    "@adonisjs/core": "^7.3.3",
    "@adonisjs/lucid": "^22.4.2",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/node": "~25.9.1",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^12.10.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "cms",
    "adonisjs",
    "inertia",
    "vue",
    "nuxt-ui"
  ]
}
