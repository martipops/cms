{
  "name": "@martipops/cms-vue",
  "version": "0.1.1",
  "description": "Edit mode for Inertia + Vue sites built with Nuxt UI: sections, collections, slide-out forms",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martipops/cms.git",
    "directory": "packages/cms-vue"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./tailwind.css": {
      "style": "./tailwind.css",
      "default": "./tailwind.css"
    }
  },
  "files": [
    "dist",
    "tailwind.css"
  ],
  "dependencies": {
    "@martipops/cms-core": "^0.1.1"
  },
  "peerDependencies": {
    "@inertiajs/vue3": "^2.0.0",
    "@nuxt/ui": "^4.0.0",
    "vue": "^3.5.0",
    "vite": "^7.0.0"
  },
  "keywords": [
    "cms",
    "adonisjs",
    "inertia",
    "vue",
    "nuxt-ui"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && vite build && vue-tsc -p tsconfig.json",
    "dev": "vite build --watch"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inertiajs/vue3": "^2.3.24",
    "@nuxt/ui": "^4.11.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^7.3.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.2"
  }
}
