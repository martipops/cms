{
  "name": "@martipops/cms-adonis",
  "version": "0.1.0",
  "description": "AdonisJS side of the CMS: content storage, validation, commit and history endpoints",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martipops/cms.git",
    "directory": "packages/cms-adonis"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./cms_provider": {
      "types": "./build/providers/cms_provider.d.ts",
      "default": "./build/providers/cms_provider.js"
    },
    "./services/main": {
      "types": "./build/services/main.d.ts",
      "default": "./build/services/main.js"
    },
    "./controller": {
      "types": "./build/src/controller.d.ts",
      "default": "./build/src/controller.js"
    },
    "./schema": {
      "types": "./build/src/schema.d.ts",
      "default": "./build/src/schema.js"
    },
    "./commands": {
      "types": "./build/commands/main.d.ts",
      "default": "./build/commands/main.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy_stubs.js && adonis-kit index build/commands",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "node --import=@poppinss/ts-exec bin/test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@martipops/cms-core": "^0.1.0"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@vinejs/vine": "^4.0.0",
    "@adonisjs/assembler": "^8.0.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.3",
    "@adonisjs/lucid": "^22.4.2",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/node": "~25.9.1",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^12.10.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "cms",
    "adonisjs",
    "inertia",
    "vue",
    "nuxt-ui"
  ],
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    }
  }
}
