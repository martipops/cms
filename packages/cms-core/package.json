{
  "name": "@martipops/cms-core",
  "version": "0.1.0",
  "description": "Isomorphic schema DSL for the CMS: field definitions, sections, collections and value helpers",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martipops/cms.git",
    "directory": "packages/cms-core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "node --import=@poppinss/ts-exec bin/test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "cms",
    "adonisjs",
    "inertia",
    "vue",
    "nuxt-ui"
  ],
  "sideEffects": false
}
