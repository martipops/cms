{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": [],
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
